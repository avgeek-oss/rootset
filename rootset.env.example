# Copy to .env, replace placeholders, and chmod 600 .env.
ROOTSET_WEB_URL=http://localhost:4300
ROOTSET_API_URL=http://localhost:4310
ROOTSET_DATABASE_URL=postgres://rootset:REPLACE_DATABASE_PASSWORD@your-postgres-host:5432/rootset
ROOTSET_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ROOTSET_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_64_HEX_DIGITS
ROOTSET_S3_ENDPOINT=https://your-s3-endpoint.example.com
ROOTSET_S3_BUCKET=rootset-artifacts
ROOTSET_S3_ACCESS_KEY=REPLACE_OBJECT_ACCESS_KEY
ROOTSET_S3_SECRET_KEY=REPLACE_OBJECT_SECRET_KEY
ROOTSET_SMTP_HOST=your-smtp-host.example.com
ROOTSET_EMAIL_FROM=rootset@example.com
# SMTP defaults: port 587, ROOTSET_SMTP_SECURE=true. Configure your provider's TLS mode.
# ROOTSET_SMTP_PORT=587
# ROOTSET_SMTP_SECURE=true
# ROOTSET_SMTP_USER=
# ROOTSET_SMTP_PASSWORD=
# Only for --profile local-db; use the same URL-safe password in ROOTSET_DATABASE_URL.
# POSTGRES_PASSWORD=
