{
  "name": "rootset",
  "version": "0.2.4",
  "description": "Self-hosted structured master data management with a spreadsheet UI, REST API and MCP.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "homepage": "https://www.rootset.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/avgeek-oss/rootset.git"
  },
  "bugs": {
    "url": "https://github.com/avgeek-oss/rootset/issues"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build && tsx tools/build-apps.ts",
    "typecheck": "turbo run typecheck",
    "lint": "eslint apps packages tools --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test --concurrency=4",
    "test:integration": "tsx --test tools/verification/*.test.ts",
    "verify": "pnpm release:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release:check": "node tools/release/validate.mjs",
    "db:migrate": "tsx tools/migrate.ts",
    "setup:env": "tsx tools/setup-env.ts",
    "verify:signoff": "tsx tools/evidence-audit.ts",
    "contracts:generate": "tsx tools/generate-contracts.ts",
    "auth:operator": "tsx tools/operator.ts",
    "docs:sync": "node tools/docs/sync-reference.mjs && mintlify-docs sync --config docs/site.json --dir docs",
    "docs:check": "mintlify-docs check --config docs/site.json --dir docs && node tools/docs/check.mjs",
    "docs:dev": "cd docs && npx --yes mint@4.2.986 dev --port 4178",
    "docs:screenshots": "node tools/docs/capture-screenshots.mjs"
  },
  "dependencies": {
    "@rootset/contracts": "workspace:*",
    "@rootset/core": "workspace:*",
    "@rootset/database": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/typescript6": "catalog:",
    "better-auth": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "yaml": "2.8.1",
    "@avgeek-oss/mintlify-docs": "0.1.6"
  }
}
