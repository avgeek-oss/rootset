{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "interaction": {
    "drilldown": false
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "twitter:card": "summary_large_image",
      "canonical": "https://www.rootset.app"
    },
    "organization": {
      "name": "Rootset",
      "url": "https://www.rootset.app",
      "logo": "https://www.rootset.app/assets/rootset-logo.png",
      "sameAs": ["https://github.com/avgeek-oss/rootset"]
    }
  },
  "name": "Rootset",
  "description": "Open-source structured data with typed tables, a spreadsheet UI, REST API and MCP. Self-host on PostgreSQL.",
  "logo": {
    "light": "/assets/rootset-logo.png",
    "dark": "/assets/rootset-logo.png",
    "href": "/"
  },
  "favicon": "/assets/rootset-logo.png",
  "colors": {
    "primary": "#2d6044",
    "light": "#8bc09e",
    "dark": "#2d6044"
  },
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Introduction",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["quickstart", "concepts"]
          },
          {
            "group": "Self-host Rootset",
            "pages": [
              "self-hosting/installation",
              "self-hosting/configuration",
              "self-hosting/upgrades",
              "self-hosting/security",
              "self-hosting/troubleshooting"
            ]
          }
        ]
      },
      {
        "dropdown": "Using Rootset",
        "icon": "table",
        "groups": [
          {
            "group": "Your data",
            "pages": [
              "databases",
              "tables",
              "fields",
              "rows",
              "filters",
              "cell-history",
              "unique-rules",
              "export-requests"
            ]
          },
          {
            "group": "Workspace",
            "pages": ["team-access", "api-keys", "account-settings"]
          }
        ]
      },
      {
        "dropdown": "API & MCP",
        "icon": "plug",
        "groups": [
          {
            "group": "Connect a client",
            "pages": ["api-guide", "mcp-guide", "mcp-tools"]
          }
        ]
      },
      {
        "dropdown": "API reference",
        "icon": "code",
        "groups": [
          {
            "group": "Accounts",
            "pages": [
              "api-reference/getContext",
              "api-reference/getProfile",
              "api-reference/updateProfile",
              "api-reference/getPreferences",
              "api-reference/updatePreferences",
              "api-reference/getPreferenceOptions",
              "api-reference/previewPreferences",
              "api-reference/listSessions",
              "api-reference/revokeSession",
              "api-reference/listConnections",
              "api-reference/revokeConnection",
              "api-reference/getOrganisation",
              "api-reference/updateOrganisation",
              "api-reference/listMembers",
              "api-reference/updateMember",
              "api-reference/removeMember",
              "api-reference/listInvitations",
              "api-reference/inviteMember",
              "api-reference/cancelInvitation",
              "api-reference/listPersonalKeys",
              "api-reference/createPersonalKey",
              "api-reference/rotatePersonalKey",
              "api-reference/revokePersonalKey",
              "api-reference/listTeamKeys",
              "api-reference/createTeamKey",
              "api-reference/rotateTeamKey",
              "api-reference/revokeTeamKey",
              "api-reference/getSecurityStatus",
              "api-reference/getMutation",
              "api-reference/getUsage",
              "api-reference/getViewPreferences",
              "api-reference/updateViewPreferences"
            ]
          },
          {
            "group": "Databases",
            "pages": [
              "api-reference/listDatabases",
              "api-reference/createDatabase",
              "api-reference/getDatabase",
              "api-reference/updateDatabase",
              "api-reference/deleteDatabase"
            ]
          },
          {
            "group": "Schema",
            "pages": [
              "api-reference/listTables",
              "api-reference/createTable",
              "api-reference/getTable",
              "api-reference/updateTable",
              "api-reference/deleteTable",
              "api-reference/getTableSchema",
              "api-reference/listFields",
              "api-reference/createField",
              "api-reference/updateField",
              "api-reference/deleteField",
              "api-reference/reorderFields",
              "api-reference/previewSchemaChange",
              "api-reference/applySchemaChange",
              "api-reference/getSchemaOperation",
              "api-reference/listUniqueRules",
              "api-reference/createUniqueRule",
              "api-reference/deleteUniqueRule"
            ]
          },
          {
            "group": "Data",
            "pages": [
              "api-reference/listRows",
              "api-reference/createRow",
              "api-reference/queryRows",
              "api-reference/getRow",
              "api-reference/updateRow",
              "api-reference/deleteRow",
              "api-reference/mutateRows",
              "api-reference/getTableStatistics",
              "api-reference/countRows",
              "api-reference/getCellHistory",
              "api-reference/queryHistory"
            ]
          },
          {
            "group": "Artifacts",
            "pages": [
              "api-reference/exportRows",
              "api-reference/getArtifact",
              "api-reference/downloadArtifactBytes"
            ]
          },
          {
            "group": "Jobs",
            "pages": [
              "api-reference/listJobs",
              "api-reference/getJob",
              "api-reference/cancelJob",
              "api-reference/retryJob"
            ]
          }
        ]
      }
    ]
  },
