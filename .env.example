# Copy this file to .env and replace each generated value. Keep .env out of Git.
# pnpm setup:env creates a local configuration with fresh credentials and keys.
ROOTSET_WEB_URL=http://localhost:4300
ROOTSET_API_URL=http://localhost:4310
ROOTSET_PORT=4310
ROOTSET_DATABASE_URL=postgres://rootset_app:REPLACE_APP_PASSWORD@postgres:5432/rootset
ROOTSET_DDL_DATABASE_URL=postgres://rootset_ddl:REPLACE_DDL_PASSWORD@postgres:5432/rootset
ROOTSET_IDENTITY_DATABASE_URL=postgres://rootset_identity:REPLACE_IDENTITY_PASSWORD@postgres:5432/rootset
ROOTSET_MIGRATION_DATABASE_URL=postgres://rootset_owner:REPLACE_OWNER_PASSWORD@postgres:5432/rootset
ROOTSET_APP_DB_PASSWORD=REPLACE_APP_PASSWORD
ROOTSET_DDL_DB_PASSWORD=REPLACE_DDL_PASSWORD
ROOTSET_IDENTITY_DB_PASSWORD=REPLACE_IDENTITY_PASSWORD
ROOTSET_OWNER_DB_PASSWORD=REPLACE_OWNER_PASSWORD
ROOTSET_AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
ROOTSET_KEY_HASH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
ROOTSET_CURSOR_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
# Optional bounded preregistration of public PKCE OAuth clients with exact redirects.
ROOTSET_OAUTH_CLIENTS=[]
ROOTSET_BOOTSTRAP_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
# New-password safety checks use the HIBP range API, as in Towbar.
ROOTSET_PASSWORD_BREACH_CHECK=true
ROOTSET_PASSWORD_VERIFY_CONCURRENCY=2
ROOTSET_PASSWORD_VERIFY_QUEUE_LIMIT=16
ROOTSET_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_64_HEX_DIGITS
ROOTSET_ENCRYPTION_KEY_ID=primary
# For rotation, retain old keys in a JSON map of key IDs to 64 hex digits.
# ROOTSET_ENCRYPTION_KEYS={"primary":"<64 hex digits>","next":"<64 hex digits>"}
# Select the new key with ROOTSET_ENCRYPTION_KEY_ID; retain needed old keys.
ROOTSET_S3_ENDPOINT=http://objects:9000
ROOTSET_S3_REGION=us-east-1
ROOTSET_S3_BUCKET=rootset-artifacts
ROOTSET_S3_ACCESS_KEY=REPLACE_OBJECT_ACCESS_KEY
ROOTSET_S3_SECRET_KEY=REPLACE_OBJECT_SECRET_KEY
# Disk-backed ciphertext spool in containers; keep at least 1 GiB free.
ROOTSET_ARTIFACT_TEMP_DIR=/var/lib/rootset/artifact-spool
# SMTP and S3 are environment-only; there are no UI or database overrides.
ROOTSET_SMTP_HOST=mail
ROOTSET_SMTP_PORT=1025
ROOTSET_SMTP_SECURE=false
# Optional SMTP authentication for an external provider.
# ROOTSET_SMTP_USER=
# ROOTSET_SMTP_PASSWORD=
ROOTSET_EMAIL_FROM=rootset@example.test
ROOTSET_WORKER_CONCURRENCY=2
ROOTSET_LOG_LEVEL=info
