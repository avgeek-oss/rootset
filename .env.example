# pnpm setup:env creates this file with fresh credentials. Keep .env out of Git.
ROOTSET_WEB_URL=http://localhost:4300
ROOTSET_API_URL=http://localhost:4310
ROOTSET_DATABASE_URL=postgres://rootset:REPLACE_POSTGRES_PASSWORD@postgres:5432/rootset
# Used only to provision the bundled PostgreSQL service; external databases do not need it.
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
ROOTSET_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
ROOTSET_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_64_HEX_DIGITS
ROOTSET_S3_ENDPOINT=http://objects:9000
ROOTSET_S3_BUCKET=rootset-artifacts
ROOTSET_S3_ACCESS_KEY=REPLACE_OBJECT_ACCESS_KEY
ROOTSET_S3_SECRET_KEY=REPLACE_OBJECT_SECRET_KEY
ROOTSET_SMTP_HOST=mail
ROOTSET_SMTP_PORT=1025
ROOTSET_SMTP_SECURE=false
ROOTSET_EMAIL_FROM=rootset@example.test
# Set these only when your SMTP provider requires authentication.
# ROOTSET_SMTP_USER=
# ROOTSET_SMTP_PASSWORD=

# Optional automated database backups. Supply these only to the worker.
# Keep the backup encryption key separately for future recovery.
# ROOTSET_BACKUP_S3_ENDPOINT=https://your-backup-endpoint.example.com
# ROOTSET_BACKUP_S3_REGION=us-east-1
# ROOTSET_BACKUP_S3_ACCESS_KEY=
# ROOTSET_BACKUP_S3_SECRET_KEY=
# ROOTSET_BACKUP_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_64_HEX_DIGITS
# ROOTSET_BACKUP_S3_FORCE_PATH_STYLE=true
# ROOTSET_BACKUP_MAX_BYTES=34359738368

# Optional in-app assistant. Configure a provider credential on the API only.
ANTHROPIC_API_KEY=
AGENT_API_KEY=
AGENT_AUTH_TOKEN=
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_PROFILE=
AGENT_EFFORT=
AGENT_MAX_TOKENS=
AGENT_HEADERS=
