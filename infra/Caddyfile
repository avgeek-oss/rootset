# Run Caddy on the host or attach its container to the Rootset network.
# Set both host names and upstreams for that deployment.
{
	servers {
		max_header_size 192KiB
	}
}

{$ROOTSET_WEB_HOST_NAME} {
	encode zstd gzip
	reverse_proxy {$ROOTSET_WEB_UPSTREAM:127.0.0.1:4300}
}

{$ROOTSET_API_HOST_NAME} {
	encode zstd gzip
	reverse_proxy {$ROOTSET_API_UPSTREAM:127.0.0.1:4310}
}
