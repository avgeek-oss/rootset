{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": ["ROOTSET_*"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["ROOTSET_*"]
    }
  },
  "globalPassThroughEnv": ["AGENT_*", "ANTHROPIC_API_KEY"]
}
